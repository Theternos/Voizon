# Copy to .env and fill in real values. Never commit the filled-in .env.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
YOUR_SITE_NAME=Voizon

# ---- OpenRouter (AI answers) ----
# The free tier is metered per key per day, so extra keys are rotated in
# automatically as each one runs out. Leave a slot as REPLACE_WITH_... to skip it.
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=REPLACE_WITH_OPENROUTER_KEY_2
OPENROUTER_API_KEY_3=REPLACE_WITH_OPENROUTER_KEY_3
OPENROUTER_API_KEY_4=REPLACE_WITH_OPENROUTER_KEY_4
OPENROUTER_API_KEY_5=REPLACE_WITH_OPENROUTER_KEY_5
OPENROUTER_API_KEY_6=REPLACE_WITH_OPENROUTER_KEY_6

# ---- Speech to text (live interview transcription) ----
DEEPGRAM_API_KEY=

# ---- Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Firebase ----
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Service account JSON on a single line
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---- Email ----
EMAIL_USER=
EMAIL_PASS=

# ---- Optional ----
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
